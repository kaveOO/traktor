# TRAKTOR — wzór pliku środowiska dla systemd (EnvironmentFile).
# Skopiuj na serwer jako /etc/traktor/traktor.env i uzupełnij wartości:
#
#   sudo install -d -o root -g traktor -m 0750 /etc/traktor
#   sudo install -o root -g traktor -m 0640 deploy/traktor.env.example /etc/traktor/traktor.env
#   sudo nano /etc/traktor/traktor.env
#   sudo systemctl restart traktor
#
# Plik zawiera sekrety: prawa 0640, właściciel root, grupa traktor. Nie trafia do repozytorium.
# Nazwy zmiennych są takie same jak w web/.env.example. Aplikacja działa bez żadnej z nich —
# wszystkie poniżej są opcjonalne poza tymi, które ustawia sama jednostka systemd
# (NODE_ENV=production, PORT=3000 w deploy/traktor.service).

# --- opcjonalne klucze -------------------------------------------------------
# Google Map Tiles (płatne). Puste = trasy /api/tiles/google/* zwracają 404,
# a podkład Google jest ukryty na /mapa. W wersji dla jury: wyłączone.
GOOGLE_MAPS_API_KEY=

# Anthropic API (płatne). Puste = /api/traktor/explain zwraca tekst z szablonu.
# Model tylko przeredagowuje gotowy opis; liczby pilnuje strażnik w kodzie.
ANTHROPIC_API_KEY=

# --- metadane wdrożenia ------------------------------------------------------
# /api/health zwraca to jako pole `sha` (domyślnie "local").
# scripts/deploy-vps.sh i scripts/deploy-vps.ps1 wpisują tu SHA wdrażanego commita.
VERCEL_GIT_COMMIT_SHA=

# --- opcjonalne --------------------------------------------------------------
# Wyłącza anonimową telemetrię Next.js (i tak ustawione w jednostce systemd).
NEXT_TELEMETRY_DISABLED=1

# Adres, na którym nasłuchuje Next.js. Jednostka systemd wymusza 127.0.0.1 (ruch idzie przez proxy).
# HOSTNAME=127.0.0.1
